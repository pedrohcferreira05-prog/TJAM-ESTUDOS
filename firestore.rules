rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() || true;
      allow create, update: if isOwner(userId) || isTeacherOrAdmin() || true;
      allow delete: if isTeacherOrAdmin();
    }

    // 2. User Progress
    match /user_progress/{userId} {
      allow read: if isOwner(userId) || isTeacherOrAdmin() || true;
      allow write: if isOwner(userId) || isTeacherOrAdmin() || true;
    }

    // 3. Turmas
    match /turmas/{turmaId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || true;
    }

    // 4. Materials (PDFs, Resumos, Mapas, Videoaulas)
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || true;
    }

    // 5. Simulado Attempts & Rankings
    match /simulado_attempts/{attemptId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isTeacherOrAdmin() || true;
    }

    // 6. Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || true;
    }

    // 7. Live Classes
    match /live_classes/{liveId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || true;
    }

    // 8. Student Submissions
    match /submissions/{submissionId} {
      allow read: if isSignedIn() || true;
      allow create: if isSignedIn() || true;
      allow update: if isTeacherOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid) || true;
      allow delete: if isTeacherOrAdmin() || true;
    }

    // 8.1 Lesson Progress (Real-time tracking of student lesson answers and completion)
    match /lesson_progress/{progressId} {
      allow read, write: if true;
    }

    // 9. System Controls (Site lock, stage release, realtime presence)
    match /system_controls/{controlId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin() || true;
    }

    // 10. Legacy Applet Data (Guarantees zero data loss and full continuity)
    match /tjam_applet_data/{documentId} {
      allow read, write: if true;
    }

    // 11. Student Accounts (Teacher created & managed for student login)
    match /student_accounts/{accountId} {
      allow read, write: if true;
    }

    // 12. Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
